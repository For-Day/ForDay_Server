# 로컬 개발용 환경변수 템플릿.
# 이 파일을 .env로 복사하고 실제 값을 채운다. .env는 git에 커밋되지 않는다.
#
#   cp .env.example .env
#
# application.yml은 spring.config.import(optional:file:.env[.properties])로
# 이 파일을 자동으로 읽는다. 값을 채우지 않아도 application.yml의 기본값으로
# 동작하지만(DB/Redis는 로컬 기본값, 나머지는 더미 값), AI/Apple/S3 관련 기능을
# 실제로 호출하려면 아래 값을 채워야 한다.

# --- DB ---
DB_URL=jdbc:mysql://localhost:3306/forday?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=root

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT --- (HS256 서명 키, 최소 32바이트 이상)
JWT_SECRET=

# --- OpenAI (Spring AI) ---
OPENAI_API_KEY=

# --- Apple Sign In ---
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- AWS S3 ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
