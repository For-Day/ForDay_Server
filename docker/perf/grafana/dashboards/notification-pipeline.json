{
  "uid": "forday-notif-perf",
  "title": "ForDay - 알림 파이프라인 측정",
  "tags": ["forday", "perf", "notification"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "톰캣 스레드 점유 (고갈 증거)",
      "description": "busy가 max에 붙어 평평해지면 스레드 풀 고갈. Stage 1의 핵심 증거 패널.",
      "datasource": { "type": "prometheus", "uid": "forday-prom" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "max" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tomcat_threads_busy_threads{job=\"forday-app\"}",
          "legendFormat": "busy"
        },
        {
          "refId": "B",
          "expr": "tomcat_threads_config_max_threads{job=\"forday-app\"}",
          "legendFormat": "max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP 응답시간 p50 / p95 / p99",
      "description": "percentiles-histogram 버킷 기반. 버킷 설정이 없으면 빈 패널로 나온다.",
      "datasource": { "type": "prometheus", "uid": "forday-prom" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"forday-app\"}[30s])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"forday-app\"}[30s])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"forday-app\"}[30s])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "처리량 / 에러 (outcome별)",
      "description": "SERVER_ERROR가 솟으면 부하가 서버를 넘어뜨린 시점.",
      "datasource": { "type": "prometheus", "uid": "forday-prom" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(http_server_requests_seconds_count{job=\"forday-app\"}[30s]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB 커넥션 풀 (HikariCP)",
      "description": "pending이 0보다 크면 스레드가 커넥션을 기다리는 중 - 고갈의 2차 원인.",
      "datasource": { "type": "prometheus", "uid": "forday-prom" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"forday-app\"}",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_pending{job=\"forday-app\"}",
          "legendFormat": "pending(대기)"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_max{job=\"forday-app\"}",
          "legendFormat": "max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "@Async 실행자 큐 (Stage 2 - 유실 대상)",
      "description": "queued가 쌓인 상태에서 프로세스를 죽이면 그만큼이 유실된다. kill 직전에 캡처할 패널.",
      "datasource": { "type": "prometheus", "uid": "forday-prom" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "executor_queued_tasks{job=\"forday-app\"}",
          "legendFormat": "{{name}} queued"
        },
        {
          "refId": "B",
          "expr": "executor_active_threads{job=\"forday-app\"}",
          "legendFormat": "{{name}} active"
        },
        {
          "refId": "C",
          "expr": "executor_pool_size{job=\"forday-app\"}",
          "legendFormat": "{{name}} pool"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RabbitMQ 큐 적체 (Stage 4)",
      "description": "ready = 소비 대기, unacked = 컨슈머가 처리 중. 브로커가 메시지를 붙들고 있다는 증거.",
      "datasource": { "type": "prometheus", "uid": "forday-prom" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages_ready{queue=\"notification.queue\"}",
          "legendFormat": "ready"
        },
        {
          "refId": "B",
          "expr": "rabbitmq_queue_messages_unacked{queue=\"notification.queue\"}",
          "legendFormat": "unacked"
        }
      ]
    }
  ]
}
